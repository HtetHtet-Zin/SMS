<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mm.com.dat.sms.mapper.UserMapper">

    <select id="findUser" resultType="mm.com.dat.sms.user.User">
        SELECT * FROM public."USER" WHERE "LOGIN_NAME" = #{username}
    </select>

</mapper>