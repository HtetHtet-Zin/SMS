<application>
    <message-bundle>MessagesResource</message-bundle>
    <locale-config>
        <default-locale>en</default-locale>
        <supported-locale>mn</supported-locale>
    </locale-config>
    <resource-bundle>
        <base-name>sms</base-name>
        <var>msg</var>
    </resource-bundle>
    <resource-bundle>
        <base-name>UserGuideResource</base-name>
        <var>guide</var>
    </resource-bundle>
    <resource-bundle>
        <base-name>ValidationMessages</base-name>
        <var>vdmsg</var>
    </resource-bundle>

    <action-listener>org.primefaces.application.DialogActionListener</action-listener>
    <navigation-handler>org.primefaces.application.DialogNavigationHandler</navigation-handler>
    <view-handler>org.primefaces.application.DialogViewHandler</view-handler>

</application>